# Railway Environment Variables
# These should be set in your Railway dashboard

# Preferred on Railway: add a variable reference to your Postgres plugin's
# DATABASE_URL or DATABASE_PRIVATE_URL on the Nakama service (no manual host).
# DATABASE_PRIVATE_URL=...   # internal, when set by Railway
# DATABASE_URL=...

# Fallback: discrete vars (POSTGRES_HOST must match your DB service name, e.g.
# mydb.railway.internal — "Postgres.railway.internal" only works if the service is named Postgres)
POSTGRES_HOST=your-railway-postgres-host
POSTGRES_DB=railway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-railway-postgres-password

# Railway will automatically provide:
# - RAILWAY_ENVIRONMENT
# - RAILWAY_SERVICE_NAME
# - PORT (Railway sets this automatically)
