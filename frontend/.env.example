# Nakama Server Configuration
VITE_NAKAMA_SERVER_URL=localhost
VITE_NAKAMA_SERVER_PORT=7350
VITE_NAKAMA_USE_SSL=false
# Must match Nakama --socket.server_key / NAKAMA_SERVER_KEY on the server (default in dev: defaultkey)
# VITE_NAKAMA_SERVER_KEY=defaultkey

# For production deployment
# VITE_NAKAMA_SERVER_URL=your-nakama-domain.com
# VITE_NAKAMA_SERVER_PORT=443
# VITE_NAKAMA_USE_SSL=true