# Alternative Railway Dockerfile using multi-stage build
# Build stage
FROM node:18-slim as builder

# Set working directory
WORKDIR /app

# Copy package files and install dependencies
COPY backend/package*.json ./
RUN npm install
RUN npm install -g typescript

# Copy source code and build
COPY backend/src/ ./src/
COPY backend/tsconfig.json ./
RUN npm run build

# Production stage
FROM heroiclabs/nakama:3.21.1

# Install curl for health checks
USER root
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Copy built TypeScript files
COPY --from=builder /app/build /nakama/build/

# Copy Nakama configuration
COPY backend/nakama-config.yml /nakama/data/

# Create necessary directories and set permissions
RUN mkdir -p /nakama/logs && \
    chmod -R 755 /nakama

# Expose ports
EXPOSE 7349 7350 7351

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:7349/v2/healthcheck || exit 1

# Start command with environment variables
CMD ["sh", "-c", "nakama --name nakama1 --database.address postgres://$POSTGRES_USER:$POSTGRES_PASSWORD@$POSTGRES_HOST:5432/$POSTGRES_DB?sslmode=prefer --logger.level INFO --session.token_expiry_sec 7200 --runtime.path /nakama/build"]