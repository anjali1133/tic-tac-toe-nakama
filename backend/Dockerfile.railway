# Railway-specific Dockerfile for Nakama backend
FROM heroiclabs/nakama:3.21.1

# Stay as root user to avoid permission issues
USER root

# Install Node.js for TypeScript compilation
RUN apt-get update && apt-get install -y \
    curl \
    && curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Set working directory and create necessary directories
WORKDIR /nakama
RUN mkdir -p /nakama/data /nakama/build

# Copy package files and install dependencies
COPY backend/package*.json ./
RUN npm install
RUN npm install -g typescript

# Copy source code
COPY backend/src/ ./src/
COPY backend/tsconfig.json ./

# Build TypeScript
RUN npm run build

# Copy Nakama configuration
COPY backend/nakama-config.yml /nakama/data/

# Expose ports
EXPOSE 7349 7350 7351

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:7349/v2/healthcheck || exit 1

# Start command with environment variables
CMD ["sh", "-c", "nakama --name nakama1 --database.address postgres://$POSTGRES_USER:$POSTGRES_PASSWORD@$POSTGRES_HOST:5432/$POSTGRES_DB?sslmode=prefer --logger.level INFO --session.token_expiry_sec 7200 --runtime.path ./build"]