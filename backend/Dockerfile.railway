# Railway-specific Dockerfile for Nakama backend
FROM heroiclabs/nakama:3.21.1

# Stay as root user to avoid permission issues
USER root

# Install Node.js for TypeScript compilation, and postgresql-client for pg_isready
RUN apt-get update && apt-get install -y \
    curl \
    postgresql-client \
    && curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Set working directory and create necessary directories
WORKDIR /nakama
RUN mkdir -p /nakama/data /nakama/build

# Copy package files and install dependencies
COPY backend/package*.json ./
RUN npm install
RUN npm install -g typescript

# Copy source code
COPY backend/src/ ./src/
COPY backend/tsconfig.json ./

# Build TypeScript
RUN npm run build

# Copy Nakama configuration and startup script
COPY backend/nakama-config-railway.yml /nakama/data/nakama-config.yml
COPY backend/start-railway.sh /nakama/start.sh
RUN chmod +x /nakama/start.sh

# Expose ports
EXPOSE 7349 7350 7351

# Health check - disable for now to avoid blocking deployment
# HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
#   CMD curl -f http://localhost:7349/ || exit 1

# Use startup script
ENTRYPOINT ["/nakama/start.sh"]